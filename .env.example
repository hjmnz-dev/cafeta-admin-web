# URL base de la API. En local, sin esta variable se usa la misma; en producción la pone el job deploy.
VITE_API_URL=http://localhost:3000/api/v1

# Monitoreo de errores (spec 0007). En local quedan vacías: sin DSN no se envía
# nada a Sentry. En producción las pone el job deploy.
# VITE_SENTRY_DSN=
# VITE_APP_VERSION=
